noncomputable section

/-! # Book 2, Chapter 7, §7.8: unramified extensions and finite precision -/

/-- The base and extended precision ideals generated by a uniformizer power. -/
abbrev Chapter07BasePrecisionIdeal
    (A : Type*) [CommRing A] (π : A) (n : ℕ) : Ideal A :=
  Ideal.span ({π ^ n} : Set A)

abbrev Chapter07ExtensionPrecisionIdeal
    (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    (π : A) (n : ℕ) : Ideal B :=
  Ideal.map (algebraMap A B) (Chapter07BasePrecisionIdeal A π n)

/-- The finite precision quotient rings appearing in §7.8. -/
abbrev Chapter07BasePrecisionQuotient
    (A : Type*) [CommRing A] (π : A) (n : ℕ) : Type _ :=
  A ⧸ Chapter07BasePrecisionIdeal A π n

abbrev Chapter07ExtensionPrecisionQuotient
    (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    (π : A) (n : ℕ) : Type _ :=
  B ⧸ Chapter07ExtensionPrecisionIdeal A B π n

/-- The quotient-algebra interface needed to compare precision quotients. -/
abbrev Chapter07PrecisionAlgebra
    (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    (π : A) (n : ℕ) :
    Algebra (Chapter07BasePrecisionQuotient A π n)
      (Chapter07ExtensionPrecisionQuotient A B π n) :=
  Ideal.Quotient.algebraQuotientOfLEComap (Ideal.le_comap_map)

/- A finite precision quotient is free of rank `f` over the corresponding
  base quotient.  `Module.rank`, rather than `Module.finrank`, is used because
  a quotient modulo `π^n` is generally not a field when `n > 1`. -/
def Chapter07FinitePrecisionFreeOfRank
    (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    (π : A) (f n : ℕ) : Prop :=
  letI := Chapter07PrecisionAlgebra A B π n
  Module.Finite (Chapter07BasePrecisionQuotient A π n)
      (Chapter07ExtensionPrecisionQuotient A B π n) ∧
    Module.Free (Chapter07BasePrecisionQuotient A π n)
      (Chapter07ExtensionPrecisionQuotient A B π n) ∧
    Cardinal.toNat (Module.rank (Chapter07BasePrecisionQuotient A π n)
      (Chapter07ExtensionPrecisionQuotient A B π n)) = f

/-- Unramified finite freeness at every precision.  The source's “determined
by the residue extension” phrase is represented by a compatible family of
these quotient bases. -/
structure Chapter07FinitePrecisionTower
    (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    (π : A) (f : ℕ) (k l : Type*) [Field k] [Field l]
    [Algebra k l] [FiniteDimensional k l] where
  finiteFree : ∀ n,
    0 < n → Chapter07FinitePrecisionFreeOfRank A B π f n
  residueDegree : Module.finrank k l = f
  residueSeparable : Chapter07ResidueExtensionIsSeparable k l

/-- For an unramified finite extension, all quotients `B/π^nB` are finite free
of rank equal to the residue degree. -/
theorem chapter07_unramified_quotients_are_free
    {A B K L k l : Type*} [CommRing A] [IsDomain A] [CommRing B]
    [IsDomain B] [Field K] [Field L] [Field k] [Field l]
    [Algebra A B] [Algebra A K] [Algebra K L] [Algebra B L]
    [Algebra A L] [Algebra k l]
    [IsScalarTower A B L] [IsScalarTower A K L]
    [IsFractionRing A K] [IsFractionRing B L]
    [FiniteDimensional K L] [FiniteDimensional k l]
    [IsIntegralClosure B A L] [HenselianLocalRing A]
    [Module.Finite A B] [Module.Free A B]
    [IsDiscreteValuationRing A] [IsDiscreteValuationRing B]
    (π : A) (f : ℕ)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span ({π} : Set A))
    (U : Chapter07UnramifiedLocalExtensionData A B K L k l)
    (hf : U.profile.residueDegree = f)
    (hresidueDegree : Module.finrank k l = f) :
    ∀ n : ℕ, 0 < n →
      Chapter07FinitePrecisionFreeOfRank A B π f n := by
  sorry

/-- A compatible family of roots modulo all powers of an ideal.  Transition
maps are explicit because the quotient-map API depends on the chosen ideal
containments. -/
structure Chapter07CompatibleRootApproximation
    (R : Type*) [CommRing R] (I : Ideal R) (p : R[X]) where
  root : ∀ n : ℕ, R ⧸ I ^ n
  transition : ∀ n : ℕ, (R ⧸ I ^ (n + 1)) →+* (R ⧸ I ^ n)
  transition_canonical : ∀ n : ℕ,
    transition n = Ideal.Quotient.factorPow I (Nat.le_succ n)
  root_equation : ∀ n : ℕ,
    eval₂ (Ideal.Quotient.mk (I ^ n)) (root n) p = 0
  compatible : ∀ n : ℕ, transition n (root (n + 1)) = root n

/-- Hensel lifting supplies compatible roots at every finite precision. -/
theorem chapter07_hensel_constructs_compatible_precision_roots
    {R : Type*} [CommRing R] [HenselianLocalRing R]
    (I : Ideal R) (p : R[X]) (gbar : (R ⧸ I)[X])
    (hI : I = IsLocalRing.maximalIdeal R)
    (hseparable : gbar.Separable) (hmonic : p.Monic)
    (hred : p.map (Ideal.Quotient.mk I) = gbar)
    (a : R ⧸ I)
    (hroot : eval₂ (Ideal.Quotient.mk I) a p = 0)
    (hderiv : IsUnit (eval₂ (Ideal.Quotient.mk I) a p.derivative)) :
    Nonempty (Chapter07CompatibleRootApproximation R I p) := by
  sorry

/-- A compatible finite-precision root family has an inverse-limit lift in the
adic completion, with its prescribed finite projections. -/
theorem chapter07_compatible_roots_have_adic_limit
    {R : Type*} [CommRing R] (I : Ideal R) (p : R[X])
    (S : Chapter07CompatibleRootApproximation R I p) :
    ∃ x : AdicCompletion I R, ∀ n,
      AdicCompletion.evalₐ I n x = S.root n := by
  sorry

/-- In equal characteristic, a chosen coefficient field identifies the
unramified ring with a literal power-series ring. -/
def Chapter07CoefficientwisePowerSeriesExpansion
    (B k' : Type*) [CommRing B] [Field k'] : Prop :=
  Nonempty (B ≃+* PowerSeries k')

/-- In mixed characteristic there is no coefficient-field embedding of a
positive-characteristic residue field into a characteristic-zero ring. -/
theorem chapter07_mixed_characteristic_has_no_coefficient_field
    {B k : Type*} [CommRing B] [Field k] [CharZero B]
    {p : ℕ} [CharP k p] [Fact p.Prime] :
    ¬Nonempty (k →+* B) := by
  sorry

/-- The warning that finite-precision data need not have a coefficientwise
power-series expansion is a property of a chosen mixed-characteristic model,
not an unconditional theorem about every ring. -/
def Chapter07FinitePrecisionHasNoCoefficientwiseExpansion
    {B k' : Type*} [CommRing B] [Field k']
    : Prop :=
  ¬Chapter07CoefficientwisePowerSeriesExpansion B k'

theorem chapter07_mixed_characteristic_has_no_coefficientwise_power_series
    {B k' : Type*} [CommRing B] [Field k'] [CharZero B]
    {p : ℕ} [CharP k' p] [Fact p.Prime] :
    Chapter07FinitePrecisionHasNoCoefficientwiseExpansion (B := B) (k' := k') := by
  sorry

end
end LastLib.Book02FiniteExtensionsOfLocalFields.Chapter07
