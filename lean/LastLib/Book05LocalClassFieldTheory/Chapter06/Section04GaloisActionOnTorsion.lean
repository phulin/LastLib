theorem chapter06_theorem_6_3
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    (n : ℕ) (hn : 0 < n)
    (f : Chapter06UnivariateSeries (Chapter06ValuationRing D))
    (hf : chapter06LubinTateCondition D f)
    (M : Chapter06FormalModuleData D f)
    (A : Chapter06TorsionAction D f n hn M)
    (ω : Chapter06PrimitiveTorsionPoint D n hn)
    [FiniteDimensional K (chapter06TorsionField D n ω.point)]
    [IsGalois K (chapter06TorsionField D n ω.point)] :
    ∃ V : Chapter06ValuedFiniteExtension D
        (chapter06TorsionField D n ω.point),
      Module.finrank K (chapter06TorsionField D n ω.point) =
          chapter06ResidueCardinality D ^ (n - 1) *
            (chapter06ResidueCardinality D - 1) ∧
        chapter06TotallyRamifiedValuedExtension D V ∧
        V.valuation (chapter06PrimitivePointInField D n hn ω) = 1 ∧
        (∀ σ τ : Gal(chapter06TorsionField D n ω.point / K),
          σ * τ = τ * σ) ∧
        Nonempty
          (Gal(chapter06TorsionField D n ω.point / K) ≃*
            (Chapter06TorsionResidueRing D n)ˣ) := by
  sorry

/-- Multiplication by `π` on the explicit torsion sets.  The proof that the
map lands at the preceding level is the formal-module torsion calculation. -/
noncomputable def chapter06TorsionPiReduction
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    (f : Chapter06UnivariateSeries (Chapter06ValuationRing D))
    (hf : chapter06LubinTateCondition D f)
    (M : Chapter06FormalModuleData D f)
    (hExplicit : f = chapter06ExplicitLubinTateSeries D)
    (n : Chapter06PositiveNat) :
    {x : AlgebraicClosure K // x ∈ chapter06TorsionSet D (n.1 + 1)} →
      {x : AlgebraicClosure K // x ∈ chapter06TorsionSet D n.1} :=
  fun x =>
    ⟨chapter06FormalModuleScalarEvaluation M D.uniformizer x.1, by
      sorry⟩

/-- Compatible choices of primitive points form a nested torsion tower. -/
structure Chapter06CompatibleTorsionTower
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    (f : Chapter06UnivariateSeries (Chapter06ValuationRing D))
    (hf : chapter06LubinTateCondition D f)
    (M : Chapter06FormalModuleData D f) where
  explicit_series : f = chapter06ExplicitLubinTateSeries D
  point : ∀ n : Chapter06PositiveNat,
    Chapter06PrimitiveTorsionPoint D n.1 n.2
  pi_reduction : ∀ n : Chapter06PositiveNat,
    {x : AlgebraicClosure K // x ∈ chapter06TorsionSet D (n.1 + 1)} →
      {x : AlgebraicClosure K // x ∈ chapter06TorsionSet D n.1}
  pi_reduction_is_formal : ∀ n x,
    pi_reduction n x =
      chapter06TorsionPiReduction D f hf M explicit_series n x
  point_compatibility : ∀ n,
    pi_reduction n ⟨(point ⟨n.1 + 1, Nat.succ_pos n.1⟩).point,
      (point ⟨n.1 + 1, Nat.succ_pos n.1⟩).torsion⟩ =
      ⟨(point n).point, (point n).torsion⟩
  point_compatibility_is_formal_pi : ∀ n,
    (pi_reduction n ⟨(point ⟨n.1 + 1, Nat.succ_pos n.1⟩).point,
      (point ⟨n.1 + 1, Nat.succ_pos n.1⟩).torsion⟩).1 =
      chapter06FormalModuleScalarEvaluation M D.uniformizer
        (point ⟨n.1 + 1, Nat.succ_pos n.1⟩).point
  field_inclusion : ∀ n,
    chapter06TorsionField D n.1 (point n).point ≤
      chapter06TorsionField D (n.1 + 1)
        (point ⟨n.1 + 1, Nat.succ_pos n.1⟩).point

theorem chapter06_compatible_torsion_tower_exists
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    (f : Chapter06UnivariateSeries (Chapter06ValuationRing D))
    (hf : chapter06LubinTateCondition D f)
    (M : Chapter06FormalModuleData D f)
    (hExplicit : f = chapter06ExplicitLubinTateSeries D) :
    Nonempty (Chapter06CompatibleTorsionTower D f hf M) := by
  sorry

theorem chapter06_torsion_fields_nested
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    (f : Chapter06UnivariateSeries (Chapter06ValuationRing D))
    (hf : chapter06LubinTateCondition D f)
    (M : Chapter06FormalModuleData D f)
    (T : Chapter06CompatibleTorsionTower D f hf M)
    (n : Chapter06PositiveNat) :
    chapter06TorsionField D n.1 (T.point n).point ≤
      chapter06TorsionField D (n.1 + 1)
        (T.point ⟨n.1 + 1, Nat.succ_pos n.1⟩).point :=
  T.field_inclusion n

noncomputable def chapter06TowerField
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    {f : Chapter06UnivariateSeries (Chapter06ValuationRing D)}
    {hf : chapter06LubinTateCondition D f}
    {M : Chapter06FormalModuleData D f}
    (T : Chapter06CompatibleTorsionTower D f hf M)
    (n : Chapter06PositiveNat) : IntermediateField K (AlgebraicClosure K) :=
  chapter06TorsionField D n.1 (T.point n).point

/- The restriction diagram makes the phrase “reduction modulo `πⁿ`” a
   first-class interface.  The reduction map is the canonical quotient-ring
   map from the preceding section, while the compatibility theorem is the
   part used by the chapter. -/
structure Chapter06TorsionTowerGaloisCompatibility
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    {f : Chapter06UnivariateSeries (Chapter06ValuationRing D)}
    {hf : chapter06LubinTateCondition D f}
    {M : Chapter06FormalModuleData D f}
    (T : Chapter06CompatibleTorsionTower D f hf M) where
  restriction : ∀ n : Chapter06PositiveNat,
    Gal(chapter06TowerField D T ⟨n.1 + 1, Nat.succ_pos n.1⟩ / K) →*
      Gal(chapter06TowerField D T n / K)
  restriction_is_restriction : ∀ n σ x,
    ((restriction n σ) x : AlgebraicClosure K) =
      (σ (⟨x.1, T.field_inclusion n x.2⟩ :
        chapter06TowerField D T ⟨n.1 + 1, Nat.succ_pos n.1⟩) : AlgebraicClosure K)
  label : ∀ n : Chapter06PositiveNat,
    Gal(chapter06TowerField D T n / K) ≃*
      (Chapter06TorsionResidueRing D n.1)ˣ
  reduction_spec : ∀ n σ,
    label n (restriction n σ) =
      chapter06TorsionResidueUnitTransition D n.1
        (label ⟨n.1 + 1, Nat.succ_pos n.1⟩ σ)

theorem chapter06_torsion_tower_galois_compatibility_exists
    {K : Type*} [Field K] [UniformSpace (AlgebraicClosure K)]
    (D : Chapter06LocalFieldData K)
    [UniformSpace (Chapter06ValuationRing D)]
    {f : Chapter06UnivariateSeries (Chapter06ValuationRing D)}
    {hf : chapter06LubinTateCondition D f}
    {M : Chapter06FormalModuleData D f}
    (T : Chapter06CompatibleTorsionTower D f hf M) :
